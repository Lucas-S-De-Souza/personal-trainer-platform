# ============================================================
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).
# ============================================================

# --- Banco de dados (PostgreSQL) ---
# Ex: Neon, Supabase, Railway, RDS, ou Postgres local.
DATABASE_URL="postgresql://usuario:senha@host:5432/thais_checkout?schema=public"

# --- Stripe ---
# Chaves de TESTE começam com sk_test_ / pk_test_.
# Nunca use a chave secreta (sk_) no front-end.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Gerado no Dashboard da Stripe > Developers > Webhooks
# (ou via `stripe listen --print-secret` em desenvolvimento local)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- E-mail (Resend) ---
RESEND_API_KEY="re_..."
EMAIL_FROM="Thais Santana Personal Trainer <contato@thaissantana.fit>"

# --- WhatsApp (Meta Cloud API) ---
# OPCIONAL por enquanto: pode deixar em branco (ADMIN_ACCESS_TOKEN="" etc.)
# até configurar a conta da Meta — o resto do app funciona normalmente,
# só a mensagem de WhatsApp fica desativada até aqui ser preenchido.
# Obtidos em business.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Nome exato do template aprovado no Meta Business Manager (veja README)
WHATSAPP_TEMPLATE_NAME="pagamento_confirmado"
WHATSAPP_TEMPLATE_LANG="pt_BR"
# DDI usado quando o telefone não vem com código de país (padrão Brasil)
WHATSAPP_DEFAULT_COUNTRY_CODE="55"

# --- Aplicação ---
# URL pública da aplicação, usada para montar links absolutos (ex: redirect_url do Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segredo usado para assinar o cookie de CSRF (gere um valor aleatório forte)
# Sugestão: openssl rand -base64 32
CSRF_SECRET="troque-por-um-segredo-aleatorio-forte"

# --- Painel administrativo (/admin) ---
# Senha de acesso da Thais ao painel. Troque por algo forte e só compartilhe
# com ela por um canal seguro (nunca por e-mail em texto puro).
ADMIN_PASSWORD="troque-por-uma-senha-forte"
# Segredo usado para assinar a sessão do painel (diferente do CSRF_SECRET)
# Sugestão: openssl rand -base64 32
ADMIN_SESSION_SECRET="troque-por-outro-segredo-aleatorio-forte"
# E-mail da Thais — é pra cá que vai o link de "esqueci minha senha"
ADMIN_EMAIL="thais@example.com"

# "development" | "production"
NODE_ENV="development"
